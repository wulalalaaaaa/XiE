# XiE_Projects contains source projects and tests. Do not ignore the tree as a
# whole; the separate EmoExec repository is connected explicitly as a submodule.

# Crystal's local Python environment and test scratch files
XiE_Projects/Crystal/CrystalServer/.venv/
XiE_Projects/Crystal/CrystalServer/.pytest-tmp/
XiE_Projects/Crystal/CrystalServer/.pytest_cache/
XiE_Projects/Crystal/CrystalServer/pytest-cache-files-*/
XiE_Projects/Crystal/CrystalServer/**/__pycache__/
XiE_Projects/Crystal/CrystalServer/**/*.pyc
XiE_Projects/Crystal/CrystalServer/tests/.*.db
XiE_Projects/Crystal/CrystalServer/data/*.db

